---
interface Props {
	id: string;
	height?: string;
}

const { id, height = '520px' } = Astro.props;
const url = 'https://www.' + 'desmos.com' + '/calculator/' + id + '?embed';

---

<div class="desmos-ram" style={`height: ${height};`}>
	<iframe
		src={url}
		title="Interaktiv Desmos-graf"
		loading="lazy"
	></iframe>
</div>

<style>
	.desmos-ram {
		margin: 1.5rem 0;
		width: 100%;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		overflow: hidden;
		background: #ffffff;
	}
	.desmos-ram iframe {
		width: 100%;
		height: 100%;
		border: none;
	}
	:global(:root[data-theme='dark']) .desmos-ram iframe {
		filter: invert(0.91) hue-rotate(180deg);
	}
</style>


