---
interface Props {
	id: string;
	title?: string;
}
const { id, title = 'Videogenomgång' } = Astro.props;
const doman = 'https://' + '://youtube-nocookie.com';
const mapp = '/em' + 'bed/';
const videoUrl = doman + mapp + id + '?rel=0&vq=hd720&playsinline=1';
---

<div class="media-ram">
	<iframe
		width="1280"
		height="720"
		src={videoUrl}
		title={title}
		loading="lazy"
		allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
		allowfullscreen
	></iframe>
</div>


<style>
	.media-ram {
		position: relative;
		padding-bottom: 56.25%;
		height: 0;
		overflow: hidden;
		border-radius: 0.5rem;
		margin: 1.5rem 0;
		border: 1px solid var(--sl-color-gray-5);
	}
	.media-ram iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
